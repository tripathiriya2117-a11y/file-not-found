# Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_ANON_KEY=your-anon-public-key

# Storage Bucket Name
SUPABASE_BUCKET_NAME=pdf-documents

# Google Gemini API Key for Semantic Vector Embeddings (gemini-embedding-001)
# Optional: If not provided, the app runs keyword & full-text search automatically
GEMINI_API_KEY=your-gemini-api-key
